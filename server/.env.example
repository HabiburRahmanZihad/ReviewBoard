DATABASE_URL="postgresql://postgres:password@localhost:5432/reviewboard?schema=public"
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
# Frontend origin(s) allowed by CORS — comma-separate several, e.g. "https://reviewboard.vercel.app,http://localhost:3000"
CLIENT_URL="http://localhost:3000"
# Number of reverse proxies in front of the app (Render: 1) so rate limits see real client IPs. Leave unset locally.
# TRUST_PROXY=1
