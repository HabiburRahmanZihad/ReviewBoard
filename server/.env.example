DATABASE_URL="postgresql://postgres:password@localhost:5432/reviewboard?schema=public"
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://localhost:3000"
# Set to true when deployed behind a reverse proxy (Render, Railway, Nginx…) so rate limits see real client IPs
# TRUST_PROXY=true
